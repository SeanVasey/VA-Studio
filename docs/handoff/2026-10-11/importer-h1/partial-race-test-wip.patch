+    public function test_a_pin_that_cannot_open_a_table_in_time_is_refused_as_contention_and_restores_the_lock_wait(): void
+    {
+        if (! $this->mysql()) {
+            // SQLite has no metadata locks; its counterpart is that the pin admits the intact connection.
+            DB::beginTransaction();
+            try {
+                (new CatalogDatabaseEvidence)->lockedStorage();
+            } finally {
+                DB::rollBack();
+            }
+            $this->assertSame(0, DB::transactionLevel());
+
+            return;
+        }
+        $pdo = DB::connection()->getPdo();
+        // A caller-chosen wait, longer than the pin's own bound, which the pin must restore afterwards.
+        $pdo->exec('SET SESSION lock_wait_timeout = 30');
+        $foreign = $this->foreignSession();
+        $foreign->exec('LOCK TABLES audit_events WRITE');
+        $refusal = null;
+        $started = microtime(true);
+        DB::beginTransaction();
+        try {
+            (new CatalogDatabaseEvidence)->lockedStorage();
+        } catch (RuntimeException $error) {
+            $refusal = $error->getMessage();
+        } finally {
+            DB::rollBack();
+            $foreign->exec('UNLOCK TABLES');
+        }
+        $this->assertSame('catalog_target_busy', $refusal);
+        $this->assertLessThan(25, microtime(true) - $started);
+        $this->assertSame(30, (int) $pdo->query('SELECT @@session.lock_wait_timeout')->fetchColumn());
+    }
+
+    public function test_a_temporary_shadow_of_a_table_outside_the_evidence_set_is_refused_by_the_pin(): void
+    {
+        $pdo = DB::connection()->getPdo();
+        DB::beginTransaction();
+        $refusal = null;
+        try {
+            // A temporary table named like a durable table outside the evidence set: the pin's open would lock the
+            // temporary table instead of the durable one. SQLite's counterpart is a temporary shadow of an evidence table.
+            $pdo->exec($this->mysql() ? 'CREATE TEMPORARY TABLE migrations (id INT)' : 'CREATE TEMP TABLE Tracks (id INTEGER)');
+            try {
+                (new CatalogDatabaseEvidence)->lockedStorage();
+            } catch (RuntimeException $error) {
+                $refusal = $error->getMessage();
+            }
+        } finally {
+            $pdo->exec($this->mysql() ? 'DROP TEMPORARY TABLE IF EXISTS migrations' : 'DROP TABLE IF EXISTS temp.Tracks');
+            DB::rollBack();
+        }
+        $this->assertSame('catalog_target_invalid', $refusal, 'A temporary shadow outside the evidence set was admitted.');
+    }
