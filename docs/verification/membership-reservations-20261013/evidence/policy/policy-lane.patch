diff --git a/app/Domain/Memberships/Production/MembershipRedemptionTerms.php b/app/Domain/Memberships/Production/MembershipRedemptionTerms.php
new file mode 100644
index 00000000..6ab08984
--- /dev/null
+++ b/app/Domain/Memberships/Production/MembershipRedemptionTerms.php
@@ -0,0 +1,124 @@
+<?php
+
+namespace App\Domain\Memberships\Production;
+
+use App\Support\CanonicalJson;
+use DateTimeImmutable;
+use DateTimeZone;
+
+/** Explicit per-period credit rules. These values neither prove catalog facts nor authorize a write. */
+final readonly class MembershipRedemptionTerms
+{
+    public const MAX_RULES = 256;
+
+    public const MAX_HONOR_SECONDS = 315360000;
+
+    private function __construct(public array $facts) {}
+
+    public static function from(array $facts): self
+    {
+        MembershipPolicyDocument::keys($facts, ['eligibility_rules', 'honor', 'release', 'available_expiry']);
+        MembershipException::require(is_array($facts['eligibility_rules']) && array_is_list($facts['eligibility_rules'])
+            && count($facts['eligibility_rules']) >= 1 && count($facts['eligibility_rules']) <= self::MAX_RULES, 'invalid_policy_value');
+        $ids = [];
+        $targets = [];
+        foreach ($facts['eligibility_rules'] as $rule) {
+            MembershipException::require(is_array($rule), 'invalid_policy_value');
+            MembershipPolicyDocument::keys($rule, ['rule_id', 'track_id', 'offer_id', 'offer_revision_id', 'license_version_id',
+                'license_manifest_hash', 'asset_manifest_hash', 'original_terms_hash', 'credit_amount']);
+            MembershipException::require(is_string($rule['rule_id'])
+                && preg_match('/\A[a-z][a-z0-9_-]{0,63}\z/D', $rule['rule_id']) === 1, 'invalid_policy_value');
+            foreach (['track_id', 'offer_id', 'offer_revision_id', 'license_version_id'] as $key) {
+                MembershipException::require(is_int($rule[$key]) && $rule[$key] >= 1 && $rule[$key] <= 2147483647, 'invalid_policy_value');
+            }
+            foreach (['license_manifest_hash', 'asset_manifest_hash', 'original_terms_hash'] as $key) {
+                MembershipException::require(is_string($rule[$key]), 'invalid_policy_value');
+                MembershipValues::hash($rule[$key]);
+            }
+            MembershipException::require(is_int($rule['credit_amount']) && $rule['credit_amount'] >= 1
+                && $rule['credit_amount'] <= MembershipPolicy::MAX_CREDITS, 'invalid_policy_value');
+            $target = implode(':', [$rule['track_id'], $rule['offer_id'], $rule['offer_revision_id'], $rule['license_version_id']]);
+            MembershipException::require(! isset($ids[$rule['rule_id']]) && ! isset($targets[$target]), 'ambiguous_eligibility_rule');
+            $ids[$rule['rule_id']] = $targets[$target] = true;
+        }
+        foreach (['honor', 'release', 'available_expiry'] as $key) {
+            MembershipException::require(is_array($facts[$key]), 'invalid_policy_value');
+        }
+        MembershipPolicyDocument::keys($facts['honor'], ['duration_seconds', 'expiry_mode']);
+        MembershipException::require(is_int($facts['honor']['duration_seconds']) && $facts['honor']['duration_seconds'] >= 1
+            && $facts['honor']['duration_seconds'] <= self::MAX_HONOR_SECONDS
+            && in_array($facts['honor']['expiry_mode'], ['cap_at_credit_expiry', 'allow_beyond_credit_expiry'], true), 'invalid_policy_value');
+        MembershipPolicyDocument::keys($facts['release'], ['before_credit_expiry', 'at_or_after_credit_expiry']);
+        MembershipException::require($facts['release']['before_credit_expiry'] === 'available'
+            && $facts['release']['at_or_after_credit_expiry'] === 'expired', 'unsupported_policy');
+        MembershipPolicyDocument::keys($facts['available_expiry'], ['mode']);
+        MembershipException::require($facts['available_expiry']['mode'] === 'expire_available_at_credit_expiry', 'unsupported_policy');
+
+        return new self($facts);
+    }
+
+    public function rule(string $ruleId): array
+    {
+        foreach ($this->facts['eligibility_rules'] as $rule) {
+            if ($rule['rule_id'] === $ruleId) {
+                return $rule;
+            }
+        }
+        throw new MembershipException('ineligible_license');
+    }
+
+    /** Match only current, producer-authenticated identities; no caller credit amount is accepted. */
+    public function ruleFor(int $trackId, int $offerId, int $offerRevisionId, int $licenseVersionId,
+        string $licenseManifestHash, string $assetManifestHash, string $originalTermsHash): array
+    {
+        foreach ($this->facts['eligibility_rules'] as $rule) {
+            if ([$rule['track_id'], $rule['offer_id'], $rule['offer_revision_id'], $rule['license_version_id'],
+                $rule['license_manifest_hash'], $rule['asset_manifest_hash'], $rule['original_terms_hash']]
+                === [$trackId, $offerId, $offerRevisionId, $licenseVersionId, $licenseManifestHash, $assetManifestHash, $originalTermsHash]) {
+                return $rule;
+            }
+        }
+        throw new MembershipException('ineligible_license');
+    }
+
+    /** An explicit beyond-expiry honor window never permits reserving already expired credits. */
+    public function honorDeadline(string $reservedAt, ?string $creditExpiresAt): string
+    {
+        MembershipValues::utc($reservedAt);
+        if ($creditExpiresAt !== null) {
+            MembershipValues::utc($creditExpiresAt);
+            MembershipException::require($reservedAt < $creditExpiresAt, 'credit_expired');
+        }
+        $deadline = (new DateTimeImmutable($reservedAt, new DateTimeZone('UTC')))
+            ->modify('+'.$this->facts['honor']['duration_seconds'].' seconds')->format('Y-m-d H:i:s');
+        MembershipException::require(strlen($deadline) === 19, 'invalid_policy_value');
+        MembershipValues::utc($deadline);
+        if ($creditExpiresAt !== null && $this->facts['honor']['expiry_mode'] === 'cap_at_credit_expiry') {
+            $deadline = min($deadline, $creditExpiresAt);
+        }
+        MembershipException::require($reservedAt < $deadline, 'invalid_policy_value');
+
+        return $deadline;
+    }
+
+    /** Destination only; this does not authorize an early, voluntary, staff or cancellation release. */
+    public function releaseDestination(string $at, ?string $creditExpiresAt): string
+    {
+        MembershipValues::utc($at);
+        if ($creditExpiresAt !== null) {
+            MembershipValues::utc($creditExpiresAt);
+        }
+
+        return $creditExpiresAt !== null && $at >= $creditExpiresAt ? 'expired' : 'available';
+    }
+
+    public function eligibilityHash(): string
+    {
+        return CanonicalJson::hash($this->facts['eligibility_rules']);
+    }
+
+    public function honorHash(): string
+    {
+        return CanonicalJson::hash($this->facts['honor']);
+    }
+}
diff --git a/tests/Feature/ProductionMembership/MembershipRedemptionPolicyFactsTest.php b/tests/Feature/ProductionMembership/MembershipRedemptionPolicyFactsTest.php
new file mode 100644
index 00000000..cfc0230a
--- /dev/null
+++ b/tests/Feature/ProductionMembership/MembershipRedemptionPolicyFactsTest.php
@@ -0,0 +1,128 @@
+<?php
+
+namespace Tests\Feature\ProductionMembership;
+
+use App\Domain\Memberships\Production\MembershipException;
+use App\Domain\Memberships\Production\MembershipPolicy;
+use App\Domain\Memberships\Production\MembershipPolicyDocument;
+use App\Domain\Memberships\Production\MembershipPolicyVersions;
+use App\Domain\Memberships\Production\MembershipRecords;
+use App\Domain\Memberships\Production\MembershipRows;
+use App\Domain\Memberships\Production\SealedMembershipPolicyFacts;
+use App\Support\CanonicalJson;
+use Illuminate\Database\QueryException;
+use Illuminate\Support\Facades\DB;
+use Tests\Support\FinalizationDatabaseMigrations;
+use Tests\Support\MembershipPolicyFixtures;
+use Tests\TestCase;
+
+class MembershipRedemptionPolicyFactsTest extends TestCase
+{
+    use FinalizationDatabaseMigrations;
+    use MembershipPolicyFixtures;
+
+    protected function setUp(): void
+    {
+        parent::setUp();
+        $this->policySetup();
+    }
+
+    public function test_current_mfa_author_retains_v2_and_real_producer_preserves_v1_without_mutating_or_upgrading_it(): void
+    {
+        $author = $this->policyStaff();
+        $v1 = $this->createPolicy($author);
+        $old = (array) DB::table(MembershipRecords::TABLE)->where('id', $v1['id'])->sole();
+        $v2 = $this->createPolicy($author, $this->creditInput());
+        $this->assertNotSame($v1['id'], $v2['id']);
+        $this->assertNotSame($v1['policy_hash'], $v2['policy_hash']);
+        $this->assertSame($v2, $this->createPolicy($author, $this->creditInput()));
+        $this->assertSame(2, DB::table(MembershipRecords::TABLE)->count());
+        foreach ([$v1, $v2] as $retained) {
+            config(['production-memberships.enabled' => true, 'production-memberships.approved_policy_hash' => $retained['policy_hash']]);
+            DB::transaction(function () use ($retained, $v2): void {
+                $rows = new MembershipRows;
+                $source = new SealedMembershipPolicyFacts;
+                $proof = $source->lock($retained['id'], $rows);
+                $source->proveCurrent($proof, $rows);
+                $binding = $proof->binding();
+                $this->assertSame($retained['policy_hash'], $binding->policyHash);
+                $this->assertTrue($binding->supports('paid_period_award'));
+                $this->assertSame($retained === $v2, $binding->supports('reserve'));
+                $this->assertFalse($binding->supports('consume'));
+                if ($retained === $v2) {
+                    $this->assertSame(2, $binding->redemptionTerms->rule('synthetic-wav')['credit_amount']);
+                    $this->assertSame('2026-10-13 00:30:00', $binding->redemptionTerms->honorDeadline('2026-10-13 00:00:00', '2026-10-13 00:30:00'));
+                } else {
+                    $this->assertNull($binding->redemptionTerms);
+                    $this->assertNull($binding->eligibleLicensePolicyHash);
+                    $this->assertNull($binding->reservationHonorPolicyHash);
+                }
+            });
+        }
+        $this->assertSame($old, (array) DB::table(MembershipRecords::TABLE)->where('id', $v1['id'])->sole());
+        $new = (array) DB::table(MembershipRecords::TABLE)->where('id', $v2['id'])->sole();
+        $document = MembershipPolicyVersions::document($new);
+        $this->assertSame(CanonicalJson::encode($this->creditInput()['redemption_terms']), CanonicalJson::encode($document->redemptionTerms->facts));
+        $this->assertStringNotContainsString('synthetic-wav', $new['payload_ciphertext']);
+        foreach (['production_membership_paid_periods', 'production_membership_redemptions', 'production_membership_credit_events'] as $table) {
+            $this->assertSame(0, DB::table($table)->count());
+        }
+        try {
+            (new MembershipPolicy)->current();
+            $this->fail('Authoring real terms cannot replace the complete operative capability gate.');
+        } catch (MembershipException $error) {
+            $this->assertSame('source_capability_absent', $error->reason);
+        }
+        foreach (['update', 'delete'] as $verb) {
+            try {
+                $query = DB::table(MembershipRecords::TABLE)->where('id', $v2['id']);
+                $verb === 'update' ? $query->update(['created_at' => '2026-01-01 00:00:00']) : $query->delete();
+                $this->fail('Retained v2 policy remains immutable.');
+            } catch (QueryException) {
+                $this->addToAssertionCount(1);
+            }
+        }
+    }
+
+    public function test_v2_authoring_requires_current_staff_mfa_and_does_not_gain_an_exception_from_explicit_terms(): void
+    {
+        foreach ([$this->policyStaff(false), $this->policyStaff(true, ['is_admin' => false])] as $author) {
+            try {
+                $this->createPolicy($author, $this->creditInput());
+                $this->fail('Explicit terms never replace current staff authorization.');
+            } catch (MembershipException $error) {
+                $this->assertContains($error->reason, ['mfa_required', 'staff_refused']);
+            }
+        }
+        $this->assertSame(0, DB::table(MembershipRecords::TABLE)->count());
+    }
+
+    public function test_a_different_credit_policy_is_not_approved_by_the_old_hash_and_new_approval_does_not_upgrade_v1(): void
+    {
+        $v1 = $this->createPolicy();
+        $v2 = $this->createPolicy(overrides: $this->creditInput());
+        foreach ([[$v1['policy_hash'], $v2['id']], [$v2['policy_hash'], $v1['id']]] as [$approved, $id]) {
+            config(['production-memberships.enabled' => true, 'production-memberships.approved_policy_hash' => $approved]);
+            try {
+                DB::transaction(fn () => (new SealedMembershipPolicyFacts)->lock($id, new MembershipRows));
+                $this->fail('A different retained version cannot inherit approval.');
+            } catch (MembershipException $error) {
+                $this->assertSame('policy_not_approved', $error->reason);
+            }
+        }
+        $row = (array) DB::table(MembershipRecords::TABLE)->where('id', $v1['id'])->sole();
+        $this->assertNull(MembershipPolicyVersions::document($row)->redemptionTerms);
+        $this->assertSame(2, DB::table(MembershipRecords::TABLE)->count());
+    }
+
+    private function creditInput(): array
+    {
+        return ['schema_version' => MembershipPolicyDocument::CREDIT_VERSION, 'scope' => 'paid_period_credit_lifecycle',
+            'redemption_terms' => ['eligibility_rules' => [['rule_id' => 'synthetic-wav', 'track_id' => 1, 'offer_id' => 2,
+                'offer_revision_id' => 3, 'license_version_id' => 4, 'license_manifest_hash' => str_repeat('a', 64),
+                'asset_manifest_hash' => str_repeat('b', 64), 'original_terms_hash' => str_repeat('c', 64), 'credit_amount' => 2]],
+                'honor' => ['duration_seconds' => 3600, 'expiry_mode' => 'cap_at_credit_expiry'],
+                'release' => ['before_credit_expiry' => 'available', 'at_or_after_credit_expiry' => 'expired'],
+                'available_expiry' => ['mode' => 'expire_available_at_credit_expiry']]];
+    }
+}
diff --git a/tests/Unit/MembershipRedemptionPolicyTest.php b/tests/Unit/MembershipRedemptionPolicyTest.php
