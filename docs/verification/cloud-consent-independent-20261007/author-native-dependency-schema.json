            "guards": [
                {
                    "TRIGGER_NAME": "customer_accounts_delete",
                    "EVENT_OBJECT_TABLE": "customer_accounts",
                    "EVENT_MANIPULATION": "DELETE",
                    "ACTION_TIMING": "BEFORE",
                    "ACTION_STATEMENT": "BEGIN IF 1=1 THEN SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT = 'Customer identity is retained'; END IF; END"
                },
                {
                    "TRIGGER_NAME": "customer_accounts_insert",
                    "EVENT_OBJECT_TABLE": "customer_accounts",
                    "EVENT_MANIPULATION": "INSERT",
                    "ACTION_TIMING": "BEFORE",
                    "ACTION_STATEMENT": "BEGIN IF NOT REGEXP_LIKE(NEW.owner_key, '^[0-9a-f]{64}$', 'c') OR NOT REGEXP_LIKE(NEW.public_id, '^[0-9a-f-]{36}$', 'c') OR EXISTS (SELECT 1 FROM customer_accounts WHERE id=NEW.id OR public_id=NEW.public_id OR user_id=NEW.user_id OR owner_key=NEW.owner_key) OR NEW.active != 1 OR NEW.access_version != 1 OR NEW.created_at IS NULL OR NEW.updated_at IS NULL OR NOT EXISTS (SELECT 1 FROM users WHERE id=NEW.user_id AND is_admin=0 AND email_verified_at IS NOT NULL) THEN SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT = 'Customer identity is retained'; END IF; END"
                },
                {
                    "TRIGGER_NAME": "customer_accounts_update",
                    "EVENT_OBJECT_TABLE": "customer_accounts",
                    "EVENT_MANIPULATION": "UPDATE",
                    "ACTION_TIMING": "BEFORE",
                    "ACTION_STATEMENT": "BEGIN IF NOT (NEW.id <=> OLD.id) OR NOT (BINARY NEW.public_id <=> BINARY OLD.public_id) OR NOT (NEW.user_id <=> OLD.user_id) OR NOT (BINARY NEW.owner_key <=> BINARY OLD.owner_key) OR NOT (NEW.created_at <=> OLD.created_at) OR NEW.active NOT IN (0,1) OR NEW.active=OLD.active OR OLD.access_version >= 4294967294 OR NEW.access_version != OLD.access_version+1 OR NEW.updated_at IS NULL OR NEW.updated_at < OLD.updated_at THEN SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT = 'Customer identity is retained'; END IF; END"
                }
            ]
        },
