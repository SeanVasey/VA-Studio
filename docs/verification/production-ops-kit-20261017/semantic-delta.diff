+
+# The authorization and origin identifiers in the paid-delivery paths are capabilities: keep them out of the access log
+# (query strings on those two routes are dropped too).
+map $request_uri $vasey_production_logged_uri {
+    "~^(?<head>/paid-grants/(?:authorizations|origins)/)[0-9a-f-]{36}(?<tail>/(?:redeem|document))(?:\?.*)?$" "${head}:uuid${tail}";
+    default $request_uri;
+}
+log_format vasey_production '$remote_addr [$time_iso8601] "$request_method $vasey_production_logged_uri" $status $body_bytes_sent '
+                            'rt=$request_time "$http_user_agent"';
+
+# Trusted-proxy handling is OFF. If, after the reviewed application change and a reviewed address list, the site sits
+# behind a proxy that you control, nginx can restore the client address for rate limiting like this (illustration only):
+#   set_real_ip_from <reviewed proxy address or range>;
+#   real_ip_header CF-Connecting-IP;      # or X-Forwarded-For with real_ip_recursive on
+# Do not enable it with an unreviewed or unbounded list: any client could then choose its own address.
