root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{ts,tsx,js,jsx,mjs,cjs,css,yml,yaml}]
indent_size = 2

[{package.json,package-lock.json,tsconfig.json,docs/brand/asset-manifest.json}]
indent_size = 2

[*.md]
indent_size = 2
trim_trailing_whitespace = false

# Contract profile inputs are hash-pinned; editors must not rewrite them on save.
[resources/contracts/**]
charset = unset
end_of_line = unset
indent_style = unset
indent_size = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
