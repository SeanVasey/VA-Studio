# PRIVATE SERVER PREPARATION TEMPLATE — not an activated installation.
# Populate through the host secret store; never commit a completed copy.
# APP_URL, APP_KEY, database credentials and media settings deliberately remain blank.
# Production commerce is still a code/review gate, not an environment switch.
APP_NAME="VASEY.AUDIO"
APP_ENV=production
APP_DEBUG=false
APP_URL=
APP_KEY=
# APP_PREVIOUS_KEYS= must only contain reviewed retained keys during key rotation.
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file

DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_SOCKET=
# MYSQL_ATTR_SSL_CA= actual trusted CA path if the selected database topology uses TLS.
# Do not set DB_URL alongside discrete credentials without reviewing its precedence.

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
CACHE_STORE=database
QUEUE_CONNECTION=database
# Retry exceeds the media job timeout (900s) and application claim lease (960s).
DB_QUEUE_RETRY_AFTER=1200
REDIS_QUEUE_RETRY_AFTER=1200
BROADCAST_CONNECTION=log

# The application and Linux workers must share this private local filesystem.
# Generic S3 configuration does not replace the current private-local adapter.
FILESYSTEM_DISK=local
MEDIA_FFMPEG=
MEDIA_FFPROBE=
MEDIA_PRLIMIT=
MEDIA_CLAMSCAN=
MEDIA_TAG_PATH=
MEDIA_TAG_SHA256=

# stderr needs a host-managed protected collector, rotation and retention policy.
LOG_CHANNEL=stderr
LOG_LEVEL=info
LOG_DEPRECATIONS_CHANNEL=null
LOG_DEPRECATIONS_TRACE=false

# No outbound customer email until a real transport and workflow are verified.
MAIL_MAILER=log
MAIL_SCHEME=
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="VASEY.AUDIO"

# Keep inquiries disabled until notice, retention and an eligible operator exist.
CONTACT_INQUIRIES_ENABLED=false
CONTACT_INQUIRIES_PRIVACY_NOTICE=
CONTACT_INQUIRIES_RETENTION_REFERENCE=
CONTACT_INQUIRIES_OPERATOR_ID=

# These policies authorize only local/testing fixtures; never fill them here.
VASEY_TEST_PRICING_POLICY=
VASEY_TEST_PROMOTIONS=
VASEY_TEST_INVENTORY_POLICY=
VASEY_TEST_EXCLUSIVE_SELECTION_POLICY=
VASEY_TEST_ORDER_POLICY=
VASEY_TEST_CHECKOUT_POLICY=
STRIPE_MODE=test
STRIPE_ACCOUNT_ID=
STRIPE_WEBHOOK_ENABLED=false
STRIPE_WEBHOOK_SECRET=
STRIPE_TEST_SECRET_KEY=
STRIPE_TEST_CHECKOUT_ENABLED=false
STRIPE_TEST_PAYMENT_PROCESSING_ENABLED=false
STRIPE_TEST_FINALIZATION_ENABLED=false
STRIPE_TEST_FINALIZATION_POLICY=
VASEY_TEST_CONTRACT_ISSUANCE_ENABLED=false
VASEY_TEST_CONTRACT_ISSUANCE_POLICY=
VASEY_TEST_FULFILLMENT_ACTIVATION_ENABLED=false
VASEY_TEST_FULFILLMENT_ACTIVATION_POLICY=
VASEY_TEST_DELIVERY_ACCESS_ENABLED=false
VASEY_TEST_DELIVERY_ACCESS_POLICY=

VITE_APP_NAME="${APP_NAME}"
