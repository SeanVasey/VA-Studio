# PRODUCTION PREPARATION TEMPLATE — payment, identity, paid, membership, billing and suppression families.
# Prepared 2026-10-07 by lane production-preparation-1. NOT an activated installation and NOT authorization.
#
# Immutable: never fill this file in place. Copy it outside the repository into the host secret store,
# populate there and never commit a completed copy. Change this template only through a reviewed PR;
# tests/Unit/ProductionEnvironmentTemplateTest.php keeps it in step with every env() key in config/.
#
# Host baseline keys (APP_*, DB_*, SESSION_*, QUEUE/MEDIA/MAIL/LOG and inquiries) are owned by
# ops/private-server/env.example and validated by `php scripts/ops/private-server-preflight.php --template`.
# They are not repeated here, except family keys that both templates must carry with identical values.
#
# Annotation per variable:  # KEY | owner: Sean|host|provider | secret: yes|no | default: <value as written>
#   owner Sean     = a business/activation decision only Sean can make (docs/handoff/2026-10-07/CLAUDE-PLAN.md §4)
#   owner host     = the selected host/operator (U-02 undecided) supplies or keeps it
#   owner provider = issued by an external provider account Sean controls; stored only in the host secret store
#   secret: yes    = must stay blank here; a value is never written to this repository
#   `KEY=value`    = the default-off value an installation starts from
#   `# KEY=`       = deliberately unset; the code default in config/ applies (an empty assignment would not)
#
# Every flag below is off. Turning one on is an activation step listed in docs/ops/production-activation-packet.md
# and needs Sean's separate, explicit authorization. Configuration is never operational proof.

# ======================================================================================
# PRODUCTION CHECKOUT (config/production_checkout.php)
# Own-account Stripe Checkout, pinned SDK 21.3.2 / API 2026-08-26.dahlia. Check with:
#   php artisan vasey:stripe-preflight --json     (no provider I/O)
# Release blockers still open: checkout frame admission (A1b), Tax255; no live webhook receiver exists.
# ======================================================================================

# PRODUCTION_CHECKOUT_HTTP_ENABLED | owner: Sean | secret: no | default: false (off)
#   Serves the production checkout HTTP routes (ProductionCheckoutController).
PRODUCTION_CHECKOUT_HTTP_ENABLED=false

# PRODUCTION_CHECKOUT_ENABLED | owner: Sean | secret: no | default: false (off)
#   fresh_checkout_enabled: admits NEW reviews/orders. Replay/read/reconcile do not depend on it.
PRODUCTION_CHECKOUT_ENABLED=false

# PRODUCTION_CHECKOUT_RECONCILIATION_ENABLED | owner: Sean | secret: no | default: false (off)
#   Authoritative provider retrieval/reconciliation of existing attempts.
PRODUCTION_CHECKOUT_RECONCILIATION_ENABLED=false

# PRODUCTION_CHECKOUT_PROVIDER_IO_ENABLED | owner: Sean | secret: no | default: false (off)
#   Any outbound Stripe request from OwnAccountStripeGateway or the confirmed preflight probe.
PRODUCTION_CHECKOUT_PROVIDER_IO_ENABLED=false

# PRODUCTION_CHECKOUT_EXEMPTION_AUTHORING_ENABLED | owner: Sean | secret: no | default: false (off)
#   Staff authoring of declared tax-exemption qualification policies. Not evidence of an exemption.
PRODUCTION_CHECKOUT_EXEMPTION_AUTHORING_ENABLED=false

# PRODUCTION_CHECKOUT_COMMITTED_READ_RECEIPTS_ENABLED | owner: Sean | secret: no | default: false (off)
#   Producer committed-read receipts for the paid consumer (Paid252).
PRODUCTION_CHECKOUT_COMMITTED_READ_RECEIPTS_ENABLED=false

# PRODUCTION_CHECKOUT_FUNDS_MODE | owner: Sean | secret: no | default: blank (fail-closed; only test|live accepted, test only in local/testing)
#   Sean decides test or live per stage; blank refuses every execution context.
PRODUCTION_CHECKOUT_FUNDS_MODE=

# PRODUCTION_CHECKOUT_STRIPE_ACCOUNT_ID | owner: provider | secret: no | default: blank (fail-closed)
#   The own Stripe account acct_ ID Sean selects; must equal the approved machine policy provider_account.account_id.
PRODUCTION_CHECKOUT_STRIPE_ACCOUNT_ID=

# PRODUCTION_CHECKOUT_STRIPE_SECRET_KEY | owner: provider | secret: yes | default: blank (fail-closed)
#   sk_<funds_mode>_ key issued to Sean; host secret store only. Restricted rk_ keys are refused.
PRODUCTION_CHECKOUT_STRIPE_SECRET_KEY=

# PRODUCTION_CHECKOUT_RETURN_ORIGIN | owner: host | secret: no | default: blank (fail-closed)
#   https origin of the storefront (no path/query/credentials); must equal the approved machine policy return_origin.
PRODUCTION_CHECKOUT_RETURN_ORIGIN=

# PRODUCTION_CHECKOUT_REVIEW_LIFETIME_SECONDS | owner: Sean | secret: no | default: blank (fail-closed; integer 30-3600 accepted)
#   Buyer review lifetime. No value is chosen here.
PRODUCTION_CHECKOUT_REVIEW_LIFETIME_SECONDS=

# ======================================================================================
# TEST-ONLY STRIPE RECEIVER AND HOSTED TEST CHECKOUT (config/payments.php)
# These serve synthetic/test-mode flows only. VerifyStripeWebhook refuses production environments and live events.
# Identical values are required in ops/private-server/env.example.
# ======================================================================================

