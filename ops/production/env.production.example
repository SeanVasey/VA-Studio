# REDIS_PREFIX | owner: host | secret: no | default: unset (code default expression in config/database.php)
#   Read by config/database.php.
# REDIS_PREFIX=

# REDIS_QUEUE | owner: host | secret: no | default: unset (code default default)
#   Read by config/queue.php.
# REDIS_QUEUE=

# REDIS_QUEUE_CONNECTION | owner: host | secret: no | default: unset (code default default)
#   Read by config/queue.php.
# REDIS_QUEUE_CONNECTION=

# REDIS_URL | owner: host | secret: yes | default: unset (code default null)
#   Read by config/database.php.
# REDIS_URL=

# REDIS_USERNAME | owner: host | secret: no | default: unset (code default null)
#   Read by config/database.php.
# REDIS_USERNAME=

# RESEND_API_KEY | owner: host | secret: yes | default: unset (code default null)
#   Read by config/services.php.
# RESEND_API_KEY=

# SESSION_CONNECTION | owner: host | secret: no | default: unset (code default null)
#   Read by config/session.php.
# SESSION_CONNECTION=

# SESSION_COOKIE | owner: host | secret: no | default: unset (code default expression in config/session.php)
#   Read by config/session.php.
# SESSION_COOKIE=

# SESSION_EXPIRE_ON_CLOSE | owner: host | secret: no | default: unset (code default false)
#   Read by config/session.php.
# SESSION_EXPIRE_ON_CLOSE=

# SESSION_PARTITIONED_COOKIE | owner: host | secret: no | default: unset (code default false)
#   Read by config/session.php.
# SESSION_PARTITIONED_COOKIE=

# SESSION_PATH | owner: host | secret: no | default: unset (code default /)
#   Read by config/session.php.
# SESSION_PATH=

# SESSION_STORE | owner: host | secret: no | default: unset (code default null)
#   Read by config/session.php.
# SESSION_STORE=

# SESSION_TABLE | owner: host | secret: no | default: unset (code default sessions)
#   Read by config/session.php.
# SESSION_TABLE=

# SLACK_BOT_USER_DEFAULT_CHANNEL | owner: host | secret: no | default: unset (code default null)
#   Read by config/services.php.
# SLACK_BOT_USER_DEFAULT_CHANNEL=

# SLACK_BOT_USER_OAUTH_TOKEN | owner: host | secret: yes | default: unset (code default null)
#   Read by config/services.php.
# SLACK_BOT_USER_OAUTH_TOKEN=

# SQS_PREFIX | owner: host | secret: no | default: unset (code default https://sqs.us-east-1.amazonaws.com/your-account-id)
#   Read by config/queue.php.
# SQS_PREFIX=

# SQS_QUEUE | owner: host | secret: no | default: unset (code default default)
#   Read by config/queue.php.
# SQS_QUEUE=

# SQS_SUFFIX | owner: host | secret: no | default: unset (code default null)
#   Read by config/queue.php.
# SQS_SUFFIX=
