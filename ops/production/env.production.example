STRIPE_MODE=test

# STRIPE_ACCOUNT_ID | owner: provider | secret: no | default: blank (receiver unavailable)
STRIPE_ACCOUNT_ID=

# STRIPE_WEBHOOK_ENABLED | owner: Sean | secret: no | default: false (off)
STRIPE_WEBHOOK_ENABLED=false

# STRIPE_WEBHOOK_SECRET | owner: provider | secret: yes | default: blank (receiver unavailable)
