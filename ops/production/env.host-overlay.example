# VASEY.AUDIO production: host values that ops/production/provision.sh and the kit fix, not secrets.
#
# compose-env.py layers this over ops/private-server/env.example (the reviewed host baseline) and
# ops/production/env.production.example (the reviewed feature-family switches, all off). It may only fill a key the base
# leaves blank or add a key the base lacks; it never overrides a value the reviewed templates set. Secrets stay blank
# here and are entered only in Forge > Site > Environment or on the host: APP_KEY (generate it on the server), DB_PASSWORD
# (from /root/vasey-production-secrets/db-app.env), MEDIA_TAG_PATH and MEDIA_TAG_SHA256 (the approved seller tag).
# APP_URL comes from `compose-env.py --host`.
#
# DB_HOST is 127.0.0.1, never localhost: the schema's triggers are defined by vasey_app@127.0.0.1. A managed or remote
# MySQL needs a reviewed change first (see ops/production/README.md, "Open reviewed changes").
DB_HOST=127.0.0.1
DB_DATABASE=vasey_production
DB_USERNAME=vasey_app
# Absolute paths installed by provision.sh (Ubuntu packages). Switch MEDIA_CLAMSCAN to /usr/bin/clamdscan only after
# ops/clamav/install-clamd.sh and its verification have passed on the host.
VASEY_PHP_CLI_BINARY=/usr/bin/php8.4
MEDIA_FFMPEG=/usr/bin/ffmpeg
MEDIA_FFPROBE=/usr/bin/ffprobe
MEDIA_PRLIMIT=/usr/bin/prlimit
MEDIA_CLAMSCAN=/usr/bin/clamscan
