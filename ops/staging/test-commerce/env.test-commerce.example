# VASEY.AUDIO staging test-commerce profile (Stripe TEST mode only)
#
# Purpose: the complete set of values the guest test-purchase chain needs on the private staging
# host: quote -> order -> Stripe Checkout (test) -> webhook or reconcile -> verified payment ->
# finalization -> test-buyer-pdf-v2 contract -> activation -> owner download.
#
# This file is a template. It holds no secret and no real value. Replace every <PLACEHOLDER> in
# the staging host's private .env, never in Git. Values marked SEAN come only from Sean.
#
#   <STAGING_HOST>       staging host name only, e.g. staging.example.com (no scheme, path or slash)
#   <acct_ID>            Stripe TEST-mode account ID that owns the key below (SEAN)
#   <sk_test_KEY>        Stripe TEST-mode standard secret key; rk_ restricted keys are refused (SEAN)
#   <whsec_SECRET>       signing secret of the Dashboard test-mode endpoint for /webhooks/stripe (SEAN)
#   <SELLER_LEGAL_NAME>  seller name shown on the test order review and test contract (SEAN)
#   <ASSENT_TEXT>        the test assent text the buyer accepts before ordering (SEAN)
#
# Merge rules:
# - Keep exactly one copy of each key in the final .env. A duplicate key silently overrides the
#   earlier one. The validator refuses duplicates.
# - JSON values sit inside single quotes, so they must not contain a single quote ('). Escape a
#   double quote inside a JSON string as \". Keep each value on one line.
# - After editing, run:  php scripts/ops/validate-test-commerce-profile.php /path/to/.env
#   If config is cached on the host, run `php artisan config:cache` again after the edit.
#
# Why this is safe in test mode, in one place:
# - Every flag below is honoured only when APP_ENV is local or testing, STRIPE_MODE is test, the
#   account is an acct_ ID and (for provider calls) the key is sk_test_. A live key is refused by
#   the SDK gateway before any request (StripeSdkCheckoutGateway::withClient).
# - The webhook receiver accepts only livemode=false own-account events with a valid signature.
# - The production checkout, production tax checkout, live webhook and production families stay
#   unmounted or hard-disabled in code. This profile sets none of their variables.
# - The JSON policies are the exact nonbinding test contracts the code compares byte for byte
#   (after canonical key ordering). Any extra, missing or changed field is refused.

# ---------------------------------------------------------------------------------------------
# 1. Runtime. The staging base .env (Lane A) owns these keys. They must have exactly these values.
# ---------------------------------------------------------------------------------------------
# Every test-commerce gate requires local or testing. Staging deliberately runs local (Sean,
# 2026-10-08). Never use testing on a host.
APP_ENV=local
# Required: debug pages would expose configuration and stack traces on a public host.
APP_DEBUG=false
# Must equal VASEY_TEST_CHECKOUT_POLICY.return_origin exactly (HTTPS, no path, no trailing slash).
APP_URL=https://<STAGING_HOST>
# Session cookies only over HTTPS. The guest's order ownership lives in this session.
SESSION_SECURE_COOKIE=true
# Webhook receipts, finalization and contract jobs are dispatched only to an asynchronous queue.
# A sync queue silently skips dispatch, leaving all work to the pipeline runner.
QUEUE_CONNECTION=database

# ---------------------------------------------------------------------------------------------
# 2. Stripe test mode (config/payments.php)
# ---------------------------------------------------------------------------------------------
# Only "test" is accepted by every test-commerce policy.
STRIPE_MODE=test
# Own account, not a connected account. The gateway calls GET /v1/account and refuses a mismatch.
STRIPE_ACCOUNT_ID=<acct_ID>
# sk_test_ only (regex in StripeSdkCheckoutGateway). Never sk_live_ or rk_.
STRIPE_TEST_SECRET_KEY=<sk_test_KEY>
# Signed test-mode snapshot events only; POST /webhooks/stripe stores a receipt, nothing more.
STRIPE_WEBHOOK_ENABLED=true
# Primary path: the Dashboard test-mode endpoint https://<STAGING_HOST>/webhooks/stripe.
# Fallback only: the secret printed by `stripe listen --print-secret` (see stripe-listen.service).
STRIPE_WEBHOOK_SECRET=<whsec_SECRET>
# Hosted Checkout Session creation for prepared test orders (CheckoutPolicy).
STRIPE_TEST_CHECKOUT_ENABLED=true
# Receipt processing and reconciliation: GET-only Stripe reads that record verified payment.
STRIPE_TEST_PAYMENT_PROCESSING_ENABLED=true
# Finalization: grants and pending entitlements from verified test payments; no provider call.
STRIPE_TEST_FINALIZATION_ENABLED=true
# Exactly FinalizationPolicy::CONTRACT. Confirmation must be observed before the order attempt
# expires, which is at most 15 minutes after the quote was created (CreateQuote::LIFETIME_MINUTES).
STRIPE_TEST_FINALIZATION_POLICY='{"schema_version":1,"purpose":"test_order_finalization","version":"test-order-finalization-v1","eligibility":"confirmation_observed_before_attempt_expiry","exception_resources":"retain_pending","grant_effective_time":"finalization_time","buyer_identity":"unverified_guest"}'

# ---------------------------------------------------------------------------------------------
# 3. Quote, pricing, inventory, order and checkout (config/commerce.php)
# ---------------------------------------------------------------------------------------------
# PricingPolicy: fixed_test tax at 0 bps. CheckoutEvidence accepts only zero test tax bound to
# the same Stripe account. The window must contain "now"; changing any byte of this policy makes
# open pricings fail with PRICING_CHANGED, so edit it only between test sessions.
VASEY_TEST_PRICING_POLICY='{"schema_version":1,"scope":"test","key":"staging-zero-test-tax","version":1,"currency":"USD","provider":"stripe","account":"<acct_ID>","effective_from":"2026-10-01T00:00:00Z","effective_until":"2027-01-01T00:00:00Z","tax":{"mode":"fixed_test","behavior":"exclusive","rounding":"line_half_up","rate_bps":0}}'
# No test campaigns. Leave empty.
VASEY_TEST_PROMOTIONS=
# InventoryPolicy: every order holds a reservation (ReserveQuoteInventory). 900 s is the 15-minute
# quote lifetime, so the reservation never ends before the quote does. Bounds: 30..3600.
VASEY_TEST_INVENTORY_POLICY='{"schema_version":1,"purpose":"test_inventory","ttl_seconds":900,"pending":"retain_until_verified_resolution"}'
# Exclusive selection stays OFF. Public offers are non-exclusive only; exclusive test activation
# is a separate reviewed exercise. Leave empty.
VASEY_TEST_EXCLUSIVE_SELECTION_POLICY=
# OrderPolicy: nonbinding seller identity and assent captured into the immutable order evidence.
# Seller name <= 160 characters without control characters; assent text <= 4000 characters.
VASEY_TEST_ORDER_POLICY='{"schema_version":1,"purpose":"test_order_preparation","version":"STAGING-TEST-ORDER-1","seller":{"legal_name":"<SELLER_LEGAL_NAME>"},"assent":{"version":"STAGING-TEST-ASSENT-1","text":"<ASSENT_TEXT>"},"buyer_identity":"unverified_guest"}'
# CheckoutPolicy: lifetimes are fixed by code (3600 s session, 900 s retry window), card only,
# zero test tax. return_origin must be the exact HTTPS staging origin, equal to APP_URL.
VASEY_TEST_CHECKOUT_POLICY='{"schema_version":1,"purpose":"test_hosted_checkout","version":"staging-test-checkout-v1","provider_lifetime_seconds":3600,"retry_seconds":900,"pending_resources":"retain_until_authoritative_finalization","tax":"fixed_test_zero","return_origin":"https://<STAGING_HOST>"}'

# ---------------------------------------------------------------------------------------------
# 4. Contracts, activation and owner delivery (config/contracts.php, config/delivery.php)
# ---------------------------------------------------------------------------------------------
# Test buyer PDF v2 (TcpdfV2ContractRenderer). Exactly ContractIssuancePolicy::V2_CONTRACT;
# the retained v1 policy is refused for new work.
VASEY_TEST_CONTRACT_ISSUANCE_ENABLED=true
VASEY_TEST_CONTRACT_ISSUANCE_POLICY='{"schema_version":1,"purpose":"test_contract_issuance","version":"test-contract-issuance-v2","profile":"test-buyer-pdf-v2","originals":"preserve_first_committed","missing_original":"restore_only","buyer_identity":"unverified_guest","entitlements":"pending","lease_seconds":300,"max_attempts":5,"retry_seconds":60}'
# Complete-order activation proof (fresh SHA-256 of every purchased file). It does not by itself
# allow downloads ("download_access":"disabled"); a per-order delivery control does.
VASEY_TEST_FULFILLMENT_ACTIVATION_ENABLED=true
VASEY_TEST_FULFILLMENT_ACTIVATION_POLICY='{"schema_version":1,"purpose":"test_fulfillment_activation","version":"test-fulfillment-activation-v1","scope":"complete_paid_order","storage":"private_local","verification":"fresh_sha256","max_verification_age_seconds":300,"pending_entitlements":"preserve","buyer_identity":"unverified_guest","download_access":"disabled"}'
# Owner delivery: 60-second single-use authorizations, at most 3 per order per minute, one stream
# attempt each, no ranges. Exactly TestAccessPolicy::CONTRACT. Each order still needs an operator
# `vasey:control-test-delivery ... block` then `... enable` (manual by design).
VASEY_TEST_DELIVERY_ACCESS_ENABLED=true
VASEY_TEST_DELIVERY_ACCESS_POLICY='{"schema_version":1,"purpose":"test_owner_delivery","version":"test-owner-delivery-v1","scope":"activated_order_owner","storage":"private_local","verification":"fresh_sha256","token_bytes":32,"authorization_ttl_seconds":60,"new_authorizations_per_order60_seconds":3,"stream_attempts":1,"ranges":"disabled","pending_entitlements":"preserve","buyer_identity":"unverified_guest"}'

# ---------------------------------------------------------------------------------------------
# 5. Test customer accounts (config/customer.php). Optional for a guest purchase.
# ---------------------------------------------------------------------------------------------
# Lets a guest claim a paid test order into a test account, so delivery survives the browser
# session. No email is ever sent: private_capture writes the one-time link to
# storage/app/private/customer-identity-capture/, readable only from a shell on the host.
VASEY_TEST_CUSTOMER_ACCOUNTS_ENABLED=true
VASEY_TEST_CUSTOMER_IDENTITY_ENABLED=true
VASEY_TEST_CUSTOMER_IDENTITY_TRANSPORT=private_capture
VASEY_TEST_PURCHASE_CLAIMS_ENABLED=true

# ---------------------------------------------------------------------------------------------
# 6. Deliberately absent. Do not add these to the staging .env for this profile.
# ---------------------------------------------------------------------------------------------
# PRODUCTION_CHECKOUT_* (all six flags off, no key), VASEY_TEST_FREE_GRANTS_ENABLED,
# VASEY_OPERATIVE_FREE_GRANTS_ENABLED, VASEY_TEST_MEMBERSHIPS_ENABLED,
# VASEY_TEST_REFUND_RESOLUTION_*, VASEY_TEST_UNPAID_RELEASE_*, VASEY_TEST_TRANSACTIONAL_NOTIFICATION*,
# VASEY_TEST_SERVICE_PROJECTS_ENABLED, VASEY_TEST_CUSTOMER_CONSENT_ENABLED.
# The validator fails if any of them is enabled.
