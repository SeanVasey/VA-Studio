# VASEY.AUDIO private test-mode staging environment (template; no secrets).
#
# Paste into Forge > Site > Environment after replacing every <...> placeholder. Forge stores it as the site
# checkout's .env; ops/staging/forge-deploy.sh validates it and installs it 0600 into each release. Never commit
# a filled copy. Covers every variable in .env.example, plus the server, cookie and logging keys staging needs.
#
# Interim profile accepted by Sean: APP_ENV=local with APP_DEBUG=false. Every test-commerce policy admits only
# `local` or `testing` (docs/hosted-test-checkout.md "Explicit test boundary"), so a `staging` value would
# switch them all off. Side effects of `local`: staff MFA is optional (enroll it anyway, see the runbook);
# robots.txt answers `Disallow: /` and pages carry `noindex, nofollow` (non-production behaviour, wanted here).
# APP_ENV is the one switch: when a reviewed `staging` admission lands, change it here and re-run
# provision.sh with --app-env staging so the deploy checks agree.

APP_NAME="VASEY.AUDIO"
APP_ENV=local
# Generate on the server once (php artisan key:generate --show) and keep it: encrypted columns need this exact key,
# and backups carry it. Never rotate blindly.
APP_KEY=<base64:... from php artisan key:generate --show>
APP_DEBUG=false
APP_URL=https://<STAGING_HOST>
# The CLI PHP that contract and grant renderer children run when a request is served by PHP-FPM (whose PHP_BINARY is
# the FPM daemon). The exact running version, not the /usr/bin/php alternatives link; validate-runtime.php probes it.
VASEY_PHP_CLI_BINARY=/usr/bin/php8.4

# Optional synthetic membership plan/credit preparation. Refused in production. Off for Monday.
VASEY_TEST_MEMBERSHIPS_ENABLED=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# The deploy and backup quiesce rely on the release-local file marker.
APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# Per-release log files under storage/logs; info keeps request noise down without hiding failures.
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_LEVEL=info
LOG_DEPRECATIONS_CHANNEL=null

# provision.sh creates the schema and the least-privilege account; the password is in
# /root/vasey-staging-secrets/db-app.env on the server. DB_HOST must be 127.0.0.1, not localhost: the
# account and every trigger DEFINER are vasey_app@127.0.0.1.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=vasey_staging
DB_USERNAME=vasey_app
DB_PASSWORD=<from /root/vasey-staging-secrets/db-app.env>

SESSION_DRIVER=database
# Guest test buyers keep delivery access only within their original session; 8 hours covers a rehearsal.
SESSION_LIFETIME=480
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# Media job timeout is 900s; reservation must exceed the 960s processing lease.
DB_QUEUE_RETRY_AFTER=1200
REDIS_QUEUE_RETRY_AFTER=1200

# Test-only, own-account Stripe snapshot webhook. Lane B's test-commerce overlay (ops/staging/test-commerce/)
# supplies the enabled values. Test mode only: forge-deploy.sh refuses any live key.
STRIPE_WEBHOOK_ENABLED=false
STRIPE_MODE=test
STRIPE_ACCOUNT_ID=
STRIPE_WEBHOOK_SECRET=

# Absolute paths installed by provision.sh (Ubuntu packages).
MEDIA_FFMPEG=/usr/bin/ffmpeg
MEDIA_FFPROBE=/usr/bin/ffprobe
MEDIA_PRLIMIT=/usr/bin/prlimit
MEDIA_CLAMSCAN=/usr/bin/clamscan
# Approved seller tag WAV, relative to the private disk (storage/app/private), and its SHA-256.
# Install it with the runbook ("Seller tag"); never commit it. Without it no tagged preview exists and nothing publishes.
MEDIA_TAG_PATH=branding/<approved-tag-file>.wav
MEDIA_TAG_SHA256=<64 lowercase hex from sha256sum>

# Disabled until owner-approved public privacy text, retention reference and eligible operator are supplied.
CONTACT_INQUIRIES_ENABLED=false
CONTACT_INQUIRIES_PRIVACY_NOTICE=
CONTACT_INQUIRIES_RETENTION_REFERENCE=
CONTACT_INQUIRIES_OPERATOR_ID=

# Database cache: lock-capable and shared by web and workers (cache locks, queue:restart, paid-delivery lock).
CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# No outbound email from staging: messages are written to the log.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="support@vasey.audio"
MAIL_FROM_NAME="${APP_NAME}"

# Unused: private media stays on the local disk shared by web and workers.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---- Test-commerce policies: blank and off here. Lane B's overlay fills them for the rehearsal. ----
# Optional explicit JSON test policy; accepted only in local/testing. See docs/quote-pricing.md.
VASEY_TEST_PRICING_POLICY=
# Optional JSON list of explicit test campaigns; see docs/promotion-pricing.md.
VASEY_TEST_PROMOTIONS=
# Internal test inventory policy; no default or production policy. See docs/shared-rights-inventory.md.
VASEY_TEST_INVENTORY_POLICY=
# Explicit local/testing exclusive selection policy; no production terms or default. See docs/exclusive-selection.md.
VASEY_TEST_EXCLUSIVE_SELECTION_POLICY=
# Explicit local/testing order preparation policy; see docs/order-preparation.md.
VASEY_TEST_ORDER_POLICY=
# Explicit hosted Stripe test policy (its return_origin must equal APP_URL).
VASEY_TEST_CHECKOUT_POLICY=
STRIPE_TEST_CHECKOUT_ENABLED=false
STRIPE_TEST_PAYMENT_PROCESSING_ENABLED=false
STRIPE_TEST_FINALIZATION_ENABLED=false
STRIPE_TEST_FINALIZATION_POLICY=
VASEY_TEST_CONTRACT_ISSUANCE_ENABLED=false
VASEY_TEST_CONTRACT_ISSUANCE_POLICY=
# sk_test_ only; restricted rk_ keys are refused. Never a live key.
STRIPE_TEST_SECRET_KEY=
# Separate local/testing complete-order activation proof. Does not authorize downloads.
VASEY_TEST_FULFILLMENT_ACTIVATION_ENABLED=false
VASEY_TEST_FULFILLMENT_ACTIVATION_POLICY=

# Internal synthetic delivery only; disabled until an exact test policy is configured.
VASEY_TEST_DELIVERY_ACCESS_ENABLED=false
VASEY_TEST_DELIVERY_ACCESS_POLICY=

# Production families stay off on staging; forge-deploy.sh refuses any PRODUCTION_CHECKOUT_*_ENABLED=true.
# PRODUCTION_CHECKOUT_HTTP_ENABLED=false
# PRODUCTION_CHECKOUT_ENABLED=false
# PRODUCTION_CHECKOUT_RECONCILIATION_ENABLED=false
# PRODUCTION_CHECKOUT_PROVIDER_IO_ENABLED=false
# PRODUCTION_CHECKOUT_EXEMPTION_AUTHORING_ENABLED=false
# PRODUCTION_CHECKOUT_COMMITTED_READ_RECEIPTS_ENABLED=false
# PRODUCTION_CHECKOUT_FUNDS_MODE=
# PRODUCTION_CHECKOUT_STRIPE_ACCOUNT_ID=
# PRODUCTION_CHECKOUT_STRIPE_SECRET_KEY=
# PRODUCTION_CHECKOUT_RETURN_ORIGIN=
# PRODUCTION_CHECKOUT_REVIEW_LIFETIME_SECONDS=
# Synthetic local/testing customer, notice, free-grant, refund and unpaid-release families (Lane B decides).
# Free grants render a PDF inside the web request; under PHP-FPM the child runs VASEY_PHP_CLI_BINARY (M-16,
# docs/ops/staging-runbook.md §7). Keep them off unless Lane B enables them and §7's FPM render check passes.
# VASEY_TEST_CUSTOMER_ACCOUNTS_ENABLED=false
# VASEY_TEST_CUSTOMER_IDENTITY_ENABLED=false
# VASEY_TEST_CUSTOMER_IDENTITY_TRANSPORT=
# VASEY_TEST_PURCHASE_CLAIMS_ENABLED=false
# VASEY_TEST_TRANSACTIONAL_NOTIFICATIONS_ENABLED=false
# VASEY_TEST_TRANSACTIONAL_NOTIFICATION_TRANSPORT=
# VASEY_TEST_TRANSACTIONAL_NOTIFICATION_POLICY=
# VASEY_TEST_FREE_GRANTS_ENABLED=false
# VASEY_OPERATIVE_FREE_GRANTS_ENABLED=false
# VASEY_TEST_REFUND_RESOLUTION_ENABLED=false
# VASEY_TEST_REFUND_RESOLUTION_POLICY=
# VASEY_TEST_UNPAID_RELEASE_ENABLED=false
# VASEY_TEST_UNPAID_RELEASE_POLICY=
