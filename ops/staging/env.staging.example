# VASEY.AUDIO private test-mode staging environment (template; no secrets).
#
# Paste into Forge > Site > Environment after replacing every <...> placeholder. Forge stores it as the site
# checkout's .env; ops/staging/forge-deploy.sh validates it and installs it 0600 into each release. Never commit
# a filled copy. Covers every variable in .env.example, plus the server, cookie and logging keys staging needs.
#
# Profile: APP_ENV=staging with APP_DEBUG=false. `staging` admits the Stripe-test commerce chain and the synthetic
# test capabilities exactly as `local` does (App\Support\Environment\TestEnvironment), requires staff TOTP MFA
# before protected admin access, and refuses Stripe live mode and live keys, live production-checkout funds,
# production customer identity and verified-production membership provenance. robots.txt answers `Disallow: /`
# and pages carry `noindex, nofollow` (non-production behaviour, wanted here). Run provision.sh with the default
# --app-env staging so the deploy checks agree. The earlier interim profile (APP_ENV=local, accepted by Sean on
# 2026-10-08) still deploys with --app-env local, but leaves staff MFA optional.

APP_NAME="VASEY.AUDIO"
APP_ENV=staging
# Generate on the server once (php artisan key:generate --show) and keep it: encrypted columns need this exact key,
# and backups carry it. Never rotate blindly.
APP_KEY=<base64:... from php artisan key:generate --show>
APP_DEBUG=false
APP_URL=https://<STAGING_HOST>
# The CLI PHP that contract and grant renderer children run when a request is served by PHP-FPM (whose PHP_BINARY is
# the FPM daemon). The exact running version, not the /usr/bin/php alternatives link; validate-runtime.php probes it.
VASEY_PHP_CLI_BINARY=/usr/bin/php8.4

# Optional synthetic membership plan/credit preparation. Refused in production. Off for Monday.
VASEY_TEST_MEMBERSHIPS_ENABLED=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# The deploy and backup quiesce rely on the release-local file marker.
APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# Per-release log files under storage/logs; info keeps request noise down without hiding failures.
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_LEVEL=info
LOG_DEPRECATIONS_CHANNEL=null

# provision.sh creates the schema and the least-privilege account; the password is in
# /root/vasey-staging-secrets/db-app.env on the server. DB_HOST must be 127.0.0.1, not localhost: the
# account and every trigger DEFINER are vasey_app@127.0.0.1.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=vasey_staging
DB_USERNAME=vasey_app
DB_PASSWORD=<from /root/vasey-staging-secrets/db-app.env>

SESSION_DRIVER=database
# Guest test buyers keep delivery access only within their original session; 8 hours covers a rehearsal.
SESSION_LIFETIME=480
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# Media job timeout is 900s; reservation must exceed the 960s processing lease.
DB_QUEUE_RETRY_AFTER=1200
REDIS_QUEUE_RETRY_AFTER=1200

# Test-only, own-account Stripe snapshot webhook. Lane B's test-commerce overlay (ops/staging/test-commerce/)
# supplies the enabled values. Test mode only: forge-deploy.sh refuses any live key.
STRIPE_WEBHOOK_ENABLED=false
STRIPE_MODE=test
STRIPE_ACCOUNT_ID=
STRIPE_WEBHOOK_SECRET=

# Absolute paths installed by provision.sh (Ubuntu packages).
MEDIA_FFMPEG=/usr/bin/ffmpeg
MEDIA_FFPROBE=/usr/bin/ffprobe
MEDIA_PRLIMIT=/usr/bin/prlimit
MEDIA_CLAMSCAN=/usr/bin/clamscan
# Approved seller tag WAV, relative to the private disk (storage/app/private), and its SHA-256.
# Install it with the runbook ("Seller tag"); never commit it. Without it no tagged preview exists and nothing publishes.
MEDIA_TAG_PATH=branding/<approved-tag-file>.wav
MEDIA_TAG_SHA256=<64 lowercase hex from sha256sum>

# Disabled until owner-approved public privacy text, retention reference and eligible operator are supplied.
CONTACT_INQUIRIES_ENABLED=false
CONTACT_INQUIRIES_PRIVACY_NOTICE=
CONTACT_INQUIRIES_RETENTION_REFERENCE=
CONTACT_INQUIRIES_OPERATOR_ID=
# Order inquiries (local, testing or staging, and only once the notice above exists): no reviewed notice, so off.
CONTACT_TEST_ORDER_INQUIRIES_ENABLED=false
# Not environment-gated; it also needs a bound InquiryAlertTransport, and the application ships none, so it is inert. Off.
CONTACT_INQUIRY_OPERATOR_NOTIFICATIONS_ENABLED=false

# Database cache: lock-capable and shared by web and workers (cache locks, queue:restart, paid-delivery lock).
CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# No outbound email from staging: messages are written to the log.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="support@vasey.audio"
MAIL_FROM_NAME="${APP_NAME}"

# Unused: private media stays on the local disk shared by web and workers.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---- Test-commerce policies: blank and off here. Lane B's overlay fills them for the rehearsal. ----
# Optional explicit JSON test policy; accepted only in local, testing or staging. See docs/quote-pricing.md.
VASEY_TEST_PRICING_POLICY=
# Optional JSON list of explicit test campaigns; see docs/promotion-pricing.md.
VASEY_TEST_PROMOTIONS=
# Internal test inventory policy; no default or production policy. See docs/shared-rights-inventory.md.
VASEY_TEST_INVENTORY_POLICY=
# Explicit test-only (local, testing or staging) exclusive selection policy; no production terms or default. See docs/exclusive-selection.md.
VASEY_TEST_EXCLUSIVE_SELECTION_POLICY=
# Explicit test-only (local, testing or staging) order preparation policy; see docs/order-preparation.md.
VASEY_TEST_ORDER_POLICY=
# Explicit hosted Stripe test policy (its return_origin must equal APP_URL).
VASEY_TEST_CHECKOUT_POLICY=
STRIPE_TEST_CHECKOUT_ENABLED=false
STRIPE_TEST_PAYMENT_PROCESSING_ENABLED=false
STRIPE_TEST_FINALIZATION_ENABLED=false
STRIPE_TEST_FINALIZATION_POLICY=
VASEY_TEST_CONTRACT_ISSUANCE_ENABLED=false
VASEY_TEST_CONTRACT_ISSUANCE_POLICY=
# sk_test_ only; restricted rk_ keys are refused. Never a live key.
STRIPE_TEST_SECRET_KEY=
# Separate test-only complete-order activation proof. Does not authorize downloads.
VASEY_TEST_FULFILLMENT_ACTIVATION_ENABLED=false
VASEY_TEST_FULFILLMENT_ACTIVATION_POLICY=

# Internal synthetic delivery only; disabled until an exact test policy is configured.
VASEY_TEST_DELIVERY_ACCESS_ENABLED=false
VASEY_TEST_DELIVERY_ACCESS_POLICY=

# Production families stay off on staging; forge-deploy.sh refuses any PRODUCTION_CHECKOUT_*_ENABLED=true.
# PRODUCTION_CHECKOUT_HTTP_ENABLED=false
# PRODUCTION_CHECKOUT_ENABLED=false
# PRODUCTION_CHECKOUT_RECONCILIATION_ENABLED=false
# PRODUCTION_CHECKOUT_PROVIDER_IO_ENABLED=false
# PRODUCTION_CHECKOUT_EXEMPTION_AUTHORING_ENABLED=false
# PRODUCTION_CHECKOUT_COMMITTED_READ_RECEIPTS_ENABLED=false
# PRODUCTION_CHECKOUT_FUNDS_MODE=
# PRODUCTION_CHECKOUT_STRIPE_ACCOUNT_ID=
# PRODUCTION_CHECKOUT_STRIPE_SECRET_KEY=
# PRODUCTION_CHECKOUT_RETURN_ORIGIN=
# PRODUCTION_CHECKOUT_REVIEW_LIFETIME_SECONDS=
# Synthetic test-only customer, notice, free-grant, refund and unpaid-release families. They stay off on staging:
# ops/staging/validate-runtime.php (the deploy gate) refuses any of the twelve capability flags unless it is false: two sit above
# (CONTACT_TEST_ORDER_INQUIRIES_ENABLED and CONTACT_INQUIRY_OPERATOR_NOTIFICATIONS_ENABLED) and ten in the capability block below;
# the synthetic catalog line after that block is not one of them and the gate does not hold it. Turning one on is a reviewed change
# to scripts/ops/capability-boundary.php and these templates, not an .env edit.
# Free grants render a PDF inside the web request; under PHP-FPM the child runs VASEY_PHP_CLI_BINARY (M-16,
# docs/ops/staging-runbook.md §7), and that change must show §7's FPM render check passing first.
# The customer-account keys are the test-commerce overlay's; they stay commented here.
# VASEY_TEST_CUSTOMER_ACCOUNTS_ENABLED=false
# VASEY_TEST_CUSTOMER_IDENTITY_ENABLED=false
# VASEY_TEST_CUSTOMER_IDENTITY_TRANSPORT=
# VASEY_TEST_PURCHASE_CLAIMS_ENABLED=false

# ---- Capability flags, stated explicitly (a default can change; this file must not depend on one). ----
# Each default is false in config/. scripts/ops/validate-test-commerce-profile.php requires these lines, with these values,
# in the final .env. Admission below is read from the policy class; "staging" means TestEnvironment::admitsTestCommerce().
# Admitted on staging by the policy classes, off because this rehearsal does not use them. The deploy gate holds them false:
# enabling one needs a reviewed change to scripts/ops/capability-boundary.php (and its tests), not just a policy line here.
VASEY_TEST_SERVICE_PROJECTS_ENABLED=false
VASEY_TEST_CUSTOMER_CONSENT_ENABLED=false
VASEY_TEST_TRANSACTIONAL_NOTIFICATIONS_ENABLED=false
# VASEY_TEST_TRANSACTIONAL_NOTIFICATION_TRANSPORT=
# VASEY_TEST_TRANSACTIONAL_NOTIFICATION_POLICY=
VASEY_TEST_FREE_GRANTS_ENABLED=false
VASEY_TEST_REFUND_RESOLUTION_ENABLED=false
# VASEY_TEST_REFUND_RESOLUTION_POLICY=
# A5 refund/dispute lifecycle: admitted on staging by RefundDisputePolicy, off because the rehearsal does not use it and the
# four policy values await Sean's decision (every write refuses while any is unset).
VASEY_TEST_REFUND_DISPUTE_ENABLED=false
# VASEY_REFUND_DISPUTE_REFUND_AUTHORITY=
# VASEY_REFUND_DISPUTE_PARTIAL_REFUNDS=
# VASEY_REFUND_DISPUTE_DISPUTE_ACCESS=
# VASEY_REFUND_DISPUTE_EXCLUSIVE_REOPENING=
VASEY_TEST_UNPAID_RELEASE_ENABLED=false
# VASEY_TEST_UNPAID_RELEASE_POLICY=
# Must stay false on staging:
# - production free grants: FreeGrantPolicy admits this flag in any environment once a reviewed identity adapter is bound.
VASEY_OPERATIVE_FREE_GRANTS_ENABLED=false
# - the support-attachment fixture is admitted in local and testing only; staging refuses it even when true.
VASEY_SUPPORT_ATTACHMENTS_FIXTURE_ENABLED=false
# Not part of the test profile, listed so the key is never left to a default. Both are production-lane or one-way:
# - the track sitemap chain (build, store, track route) is not environment-gated and only the production index serves it; host and
#   content acceptance are separate gates;
DISCOVERY_SITEMAP_ENABLED=false
# - promoting customer listening data to V2 is not reversible by turning it off again; it needs a reviewed stopped upgrade.
VASEY_LISTENING_V2_PROMOTION_ENABLED=false
# VASEY_LISTENING_V2_ROLLOUT_REVIEW_REFERENCE=

# ---- Outside the capability profile: the profile validator does not check this line and the deploy gate does not hold it. ----
# Synthetic rehearsal catalog (`vasey:staging-synthetic-catalog`, docs/ops/staging-runbook.md section 5a). It admits only that console
# command, which also needs Stripe test mode, the two Synthetic staff accounts and a seller tag, so the deploy gate does not hold it.
# Set true only while seeding the rehearsal catalog, and back to false before real content (section 5a).
VASEY_STAGING_SYNTHETIC_CATALOG_ENABLED=false
