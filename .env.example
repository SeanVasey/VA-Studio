APP_NAME="VASEY.AUDIO"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=vaseyaudio
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# Media job timeout is 900s; reservation must exceed the 960s processing lease.
DB_QUEUE_RETRY_AFTER=1200
REDIS_QUEUE_RETRY_AFTER=1200

# Test-only, own-account Stripe snapshot webhook. Supply secrets through the host's secret store.
STRIPE_WEBHOOK_ENABLED=false
STRIPE_MODE=test
STRIPE_ACCOUNT_ID=
STRIPE_WEBHOOK_SECRET=

MEDIA_FFMPEG=/usr/bin/ffmpeg
MEDIA_FFPROBE=/usr/bin/ffprobe
MEDIA_PRLIMIT=/usr/bin/prlimit
MEDIA_CLAMSCAN=/usr/bin/clamscan
# Place your approved seller tag WAV on the private local disk; never commit it.
MEDIA_TAG_PATH=
MEDIA_TAG_SHA256=

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Optional explicit JSON test policy; accepted only in local/testing. See docs/quote-pricing.md.
VASEY_TEST_PRICING_POLICY=
# Optional JSON list of explicit test campaigns; see docs/promotion-pricing.md.
VASEY_TEST_PROMOTIONS=
# Internal test inventory policy; no default or production policy. See docs/shared-rights-inventory.md.
VASEY_TEST_INVENTORY_POLICY=
# Explicit local/testing exclusive selection policy; no production terms or default. See docs/exclusive-selection.md.
VASEY_TEST_EXCLUSIVE_SELECTION_POLICY=
