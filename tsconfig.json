{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": [
      "vite/client",
      "vitest/globals",
      "@testing-library/jest-dom/vitest",
      "node"
    ]
  },
  "include": [
    "resources/js",
    "vite.config.ts",
    "vite.preview.config.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "tests/frontend",
    "tests/browser"
  ]
}
